{%- liquid
  if settings.animations_reveal_on_scroll
    assign reveal = ' scroll-trigger animate--slide-in'
  endif
  assign image = section.settings.image
  if image == blank and section.settings.product != blank
    assign image = section.settings.product.featured_image
  endif
-%}

<section
  {% if section.settings.anchor != blank %}id="{{ section.settings.anchor | handleize }}"{% endif %}
  class="ehora-story ehora-story--media-{{ section.settings.media_position }}{% unless section.settings.show_numbers %} ehora-story--no-numbers{% endunless %} ehora-section color-{{ section.settings.color_scheme }} gradient"
  aria-labelledby="EhoraStory-{{ section.id }}"
>
  <div class="ehora-container ehora-story__grid">
    <div class="ehora-story__media">
      <div class="ehora-media">
        {%- render 'ehora-image',
          image: image,
          fallback: section.settings.default_image,
          alt: section.settings.placeholder_label,
          sizes: '(min-width: 990px) 45vw, 100vw'
        -%}
      </div>
    </div>

    <div class="ehora-story__content">
      <div class="{{ reveal | strip }}">
        {%- if section.settings.eyebrow != blank -%}
          <p class="ehora-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 id="EhoraStory-{{ section.id }}" class="ehora-display ehora-story__heading">
          {{- section.settings.heading -}}
        </h2>
        {%- if section.settings.intro != blank -%}
          <div class="ehora-lede">{{ section.settings.intro }}</div>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <ol class="ehora-story__steps">
          {%- for block in section.blocks -%}
            <li class="ehora-step{{ reveal }}" data-cascade {{ block.shopify_attributes }}>
              <h3 class="ehora-step__title">{{ block.settings.title | escape }}</h3>
              {%- if block.settings.text != blank -%}
                <div class="ehora-step__text">{{ block.settings.text }}</div>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ol>
      {%- endif -%}

      {%- if section.settings.link_label != blank and section.settings.link != blank -%}
        <div class="ehora-actions">
          <a href="{{ section.settings.link }}" class="ehora-link">
            {{- section.settings.link_label | escape -}}
            {%- render 'ehora-icon-arrow' -%}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "EHORA · Historia",
  "tag": "div",
  "class": "section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Ancla"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen",
      "info": "Formato vertical 4:5. En escritorio se queda fija mientras se leen los pasos."
    },
    {
      "type": "product",
      "id": "product",
      "label": "Producto (opcional)",
      "info": "Si no eliges imagen, se usa la imagen principal de este producto."
    },
    {
      "type": "text",
      "id": "default_image",
      "label": "Imagen por defecto (archivo del theme)"
    },
    {
      "type": "text",
      "id": "placeholder_label",
      "label": "Texto alternativo de la imagen",
      "default": "Fotografía de producto"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Posición de la imagen",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Titular",
      "default": "Pensado para todo lo que llevas al club."
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introducción"
    },
    {
      "type": "checkbox",
      "id": "show_numbers",
      "label": "Numerar los pasos",
      "default": true
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Enlace"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Destino del enlace"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Paso",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Título del paso"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Texto"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "EHORA · Historia del paletero",
      "settings": {
        "eyebrow": "El paletero",
        "heading": "Pensado para todo lo que llevas al <em>club</em>.",
        "placeholder_label": "Paletero EHORA",
        "link_label": "Ver el paletero"
      },
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Diseñado para el club",
            "text": "<p>Acolchado de trazo orgánico, blanco roto y ribetes en azul EHORA. Se reconoce antes de llegar a la pista.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Todo en su sitio",
            "text": "<p>Compartimento principal para las palas, bolsillos laterales y un hueco pensado para la botella.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Hecho para acompañarte",
            "text": "<p>Asas y correas para llevarlo del coche a la pista y de la pista a casa.</p>"
          }
        }
      ]
    },
    {
      "name": "EHORA · Por qué presurizar",
      "settings": {
        "anchor": "presion",
        "eyebrow": "La pelota",
        "heading": "Por qué <em>presurizar</em> tus pelotas.",
        "intro": "<p>Una pelota de pádel no se gasta solo jugando. También se gasta esperando al siguiente partido.</p>",
        "placeholder_label": "Presurizador EHORA",
        "media_position": "right",
        "color_scheme": "scheme-3",
        "link_label": "Ver presurizadores"
      },
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Pelotas nuevas",
            "text": "<p>Al abrir el bote, la pelota tiene la presión con la que sale de fábrica. Es cuando mejor responde.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "El juego",
            "text": "<p>Cada partido forma parte de su vida. Eso no se puede evitar, ni hace falta.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "La presión baja",
            "text": "<p>Una vez abierto el bote, la pelota va perdiendo presión con el tiempo, también cuando no se usa.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Se nota en la pista",
            "text": "<p>Menos bote, menos salida. La sensación cambia, aunque la pelota parezca nueva.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Guardarlas bajo presión",
            "text": "<p>Un presurizador está pensado para guardar las pelotas en un entorno presurizado entre partidos.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Listas para el siguiente partido",
            "text": "<p>El objetivo es sencillo: conservarlas en mejores condiciones durante más tiempo.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}

{%- comment -%} Reseñas reales. Sin bloques, la sección no aparece en la tienda. {%- endcomment -%}
{%- liquid
  assign count = section.blocks.size
  assign sum = 0
  for block in section.blocks
    assign r = block.settings.rating | plus: 0
    assign sum = sum | plus: r
  endfor
-%}
{%- if count > 0 -%}
  <section class="em-reviews em-section color-{{ section.settings.color_scheme }} gradient" aria-labelledby="EmReviews-{{ section.id }}">
    <div class="em-wrap">
      <header class="em-head">
        <div>
          {%- if section.settings.eyebrow != blank -%}<p class="em-label">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
          <h2 id="EmReviews-{{ section.id }}" class="em-title">{{ section.settings.heading }}</h2>
        </div>
        {%- if section.settings.show_average -%}
          {%- assign avg = sum | times: 1.0 | divided_by: count | round: 1 -%}
          <p class="em-reviews__avg"><strong>{{ avg }}</strong><span>de 5 · {{ count }} {% if count == 1 %}reseña{% else %}reseñas{% endif %}</span></p>
        {%- endif -%}
      </header>
      <ul class="em-reviews__list" role="list">
        {%- for block in section.blocks -%}
          {%- assign rating = block.settings.rating | plus: 0 -%}
          <li class="em-review" {{ block.shopify_attributes }}>
            {%- render 'em-stars', rating: rating -%}
            <blockquote>{{ block.settings.quote | escape }}</blockquote>
            <p class="em-review__who"><strong>{{ block.settings.name | escape }}</strong>{%- if block.settings.detail != blank %} · {{ block.settings.detail | escape }}{% endif -%}</p>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </section>
{%- elsif request.design_mode -%}
  <section class="em-section em-wrap"><p class="em-note">Reseñas: añade aquí reseñas reales de clientes (con su permiso). Mientras no haya ninguna, esta sección no se muestra en la tienda.</p></section>
{%- endif -%}

{% schema %}
{
  "name": "Maestra · Reseñas",
  "tag": "div",
  "class": "section",
  "max_blocks": 9,
  "settings": [
    { "type": "paragraph", "content": "Usa solo reseñas reales, con permiso del cliente." },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Desde el club" },
    { "type": "inline_richtext", "id": "heading", "label": "Titular", "default": "Lo que se dice en la <em>pista</em>." },
    { "type": "checkbox", "id": "show_average", "label": "Mostrar nota media", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de color", "default": "scheme-1" }
  ],
  "blocks": [
    { "type": "review", "name": "Reseña", "settings": [
      { "type": "select", "id": "rating", "label": "Puntuación", "options": [
        { "value": "5", "label": "5 estrellas" }, { "value": "4", "label": "4 estrellas" }, { "value": "3", "label": "3 estrellas" }, { "value": "2", "label": "2 estrellas" }, { "value": "1", "label": "1 estrella" }
      ], "default": "5" },
      { "type": "textarea", "id": "quote", "label": "Reseña" },
      { "type": "text", "id": "name", "label": "Nombre", "default": "Nombre" },
      { "type": "text", "id": "detail", "label": "Detalle", "info": "Ciudad o producto." }
    ] }
  ],
  "presets": [{ "name": "Maestra · Reseñas" }]
}
{% endschema %}

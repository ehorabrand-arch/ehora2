{%- comment -%}
  Rejilla de producto: foto de estudio, segunda foto al pasar el ratón, nombre en mayúsculas espaciadas y
  precio debajo. Con producto asignado usa sus datos reales; sin él, la foto y el texto del bloque.
{%- endcomment -%}
{%- liquid
  assign collection_url = routes.all_products_collection_url
  if section.settings.collection != blank
    assign collection_url = section.settings.collection.url
  endif
-%}
<section class="club-products" aria-labelledby="ClubProducts-{{ section.id }}" style="--club-cols: {{ section.settings.columns }};">
  <div class="club-container">
    {%- if section.settings.heading != blank -%}
      <h2 id="ClubProducts-{{ section.id }}" class="club-title">{{ section.settings.heading | escape }}</h2>
    {%- else -%}
      <h2 id="ClubProducts-{{ section.id }}" class="visually-hidden">Productos</h2>
    {%- endif -%}

    <ul class="club-products__grid" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign product = block.settings.product
          assign link = block.settings.link | default: collection_url
          assign title = block.settings.title
          assign image = block.settings.image
          assign image_hover = block.settings.image_hover
          if product != blank
            assign link = product.url
            assign title = product.title
            if image == blank
              assign image = product.featured_media.preview_image
            endif
            if image_hover == blank and product.media.size > 1
              assign image_hover = product.media[1].preview_image
            endif
          endif
          assign has_hover = false
          if image_hover != blank or block.settings.default_image_hover != blank
            assign has_hover = true
          endif
        -%}
        <li class="club-card" {{ block.shopify_attributes }}>
          <a href="{{ link }}" class="club-card__link">
            <span class="club-card__media{% if has_hover %} has-hover{% endif %}">
              <span class="club-card__img">
                {%- render 'ehora-image', image: image, fallback: block.settings.default_image, alt: title, sizes: '(min-width: 990px) 25vw, 50vw' -%}
              </span>
              {%- if has_hover -%}
                <span class="club-card__img club-card__img--hover" aria-hidden="true">
                  {%- render 'ehora-image', image: image_hover, fallback: block.settings.default_image_hover, alt: '', sizes: '(min-width: 990px) 25vw, 50vw' -%}
                </span>
              {%- endif -%}
              {%- if block.settings.badge != blank -%}
                <span class="club-card__badge">{{ block.settings.badge | escape }}</span>
              {%- endif -%}
            </span>
            <span class="club-card__title">{{ title | escape }}</span>
            <span class="club-card__price">
              {%- if product != blank -%}
                {%- if product.available == false -%}
                  {{ 'products.product.sold_out' | t }}
                {%- else -%}
                  {%- if product.price_varies -%}Desde {% endif -%}{{ product.price_min | money }}
                {%- endif -%}
              {%- else -%}
                {{ block.settings.caption | escape }}
              {%- endif -%}
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>

    {%- if section.settings.button_label != blank -%}
      <div class="club-products__more">
        <a href="{{ collection_url }}" class="club-button">{{ section.settings.button_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Club · Rejilla de producto",
  "tag": "div",
  "class": "section",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "heading", "label": "Titular" },
    { "type": "range", "id": "columns", "label": "Columnas en escritorio", "min": 2, "max": 4, "step": 1, "default": 4 },
    { "type": "collection", "id": "collection", "label": "Colección del botón", "info": "Vacío: todos los productos." },
    { "type": "text", "id": "button_label", "label": "Botón", "default": "Ver colección al completo" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Producto",
      "settings": [
        { "type": "product", "id": "product", "label": "Producto", "info": "Usa su foto, nombre y precio reales." },
        { "type": "text", "id": "badge", "label": "Etiqueta", "info": "Opcional, p. ej. «Nuevo»." },
        { "type": "image_picker", "id": "image", "label": "Imagen" },
        { "type": "image_picker", "id": "image_hover", "label": "Imagen al pasar el ratón" },
        { "type": "header", "content": "Sin producto asignado" },
        { "type": "text", "id": "title", "label": "Nombre", "default": "Paletero EHORA" },
        { "type": "text", "id": "caption", "label": "Texto bajo el nombre", "default": "Próximamente" },
        { "type": "url", "id": "link", "label": "Enlace" },
        { "type": "text", "id": "default_image", "label": "Imagen por defecto (archivo del theme)" },
        { "type": "text", "id": "default_image_hover", "label": "Imagen al pasar por defecto (archivo del theme)" }
      ]
    }
  ],
  "presets": [{ "name": "Club · Rejilla de producto", "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }, { "type": "item" }] }]
}
{% endschema %}

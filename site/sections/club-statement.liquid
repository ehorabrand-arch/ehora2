{%- comment -%} Texto de marca centrado: antetítulo espaciado y un párrafo corto. {%- endcomment -%}
<section class="club-statement" aria-labelledby="ClubStatement-{{ section.id }}">
  <div class="club-container club-statement__inner">
    <h2 id="ClubStatement-{{ section.id }}" class="club-title">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.text != blank -%}
      <div class="club-statement__text">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="club-button">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Club · Texto de marca",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titular", "default": "El club" },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>EHORA nace en la pista: piezas para quienes cuidan el juego antes, durante y después del partido.</p>" },
    { "type": "text", "id": "button_label", "label": "Botón" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón" }
  ],
  "presets": [{ "name": "Club · Texto de marca" }]
}
{% endschema %}

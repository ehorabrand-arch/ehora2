    "manifiesto": {
      "type": "ehora-words",
      "settings": {
        "anchor": "manifiesto",
        "eyebrow": "Manifiesto",
        "text": "El pádel no termina cuando acaba el partido. Sigue en la bolsa que cierras sin prisa y en las pelotas que guardas para el siguiente. Para eso existe EHORA.",
        "color_scheme": "scheme-2"
      }
    },
    "paletero": {
      "type": "ehora-gallery",
      "blocks": {
        "club": {
          "type": "slide",
          "settings": {
            "default_image": "ehora-foto-03.webp",
            "image_alt": "Detalle del acolchado navy, la cremallera y el ribete crema del paletero EHORA",
            "title": "Diseñado para el club",
            "text": "Acolchado en ondas, ribetes en contraste y un tirador pensado para la mano. Se reconoce antes de llegar a la pista."
          }
        },
        "orden": {
          "type": "slide",
          "settings": {
            "default_image": "ehora-foto-08.webp",

        "text": "Guarda tus pelotas, elige la presión y consúltala en la pantalla.",
        "default_image": "ehora-foto-10.webp",
        "image_alt": "Presurizador EHORA negro con pantalla digital que marca 1,92 bar sobre una pista de pádel",
        "link_label": "",
        "link": "",

{%- comment -%}
  Botón «Ver en 3D» + visor en ventana. El modelo y la librería solo se descargan al pulsar.
  El botón no aparece hasta que se activa en el bloque y se indica la URL del modelo (.glb).
  Accepts:
  - block: {Object} bloque «Ver en 3D» de la ficha de producto
{%- endcomment -%}
{%- liquid
  assign model_url = block.settings.model_url | strip
  assign color_option = block.settings.color_option | default: 'Color'
-%}
{%- assign only_tag = block.settings.only_tag | strip -%}
{%- assign tag_ok = true -%}
{%- if only_tag != blank and product.tags contains only_tag -%}{%- assign tag_ok = true -%}{%- elsif only_tag != blank -%}{%- assign tag_ok = false -%}{%- endif -%}
{%- if block.settings.show and model_url != blank and tag_ok -%}
  {{ 'ehora-3d.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'ehora-3d.js' | asset_url }}" defer="defer"></script>
  <ehora-3d
    class="e3d"
    data-model="{{ model_url | escape }}"
    data-lib="{{ 'model-viewer.min.js' | asset_url }}"
    data-option="{{ color_option | escape }}"
    {{ block.shopify_attributes }}
  >
    <button type="button" class="button button--secondary button--full-width e3d__open" data-e3d-open aria-haspopup="dialog">
      <svg class="e3d__cube" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
        <path d="M12 2.5 3.5 7v10L12 21.5 20.5 17V7L12 2.5Zm0 0v9.5m0 0L3.5 7M12 12l8.5-5" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
      </svg>
      {{ block.settings.button_label | escape }}
    </button>

    <dialog class="e3d__dialog" aria-labelledby="E3dTitle-{{ block.id }}">
      <div class="e3d__panel">
        <header class="e3d__head">
          <h2 id="E3dTitle-{{ block.id }}" class="e3d__title">{{ block.settings.title | escape }}</h2>
          <button type="button" class="e3d__close" data-e3d-close aria-label="Cerrar la vista 3D">
            <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 4l12 12M16 4 4 16" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
          </button>
        </header>

        <div class="e3d__stage" data-e3d-stage>
          <p class="e3d__status" data-e3d-status role="status">Cargando el modelo…</p>
          <div class="e3d__bar" aria-hidden="true"><span data-e3d-progress></span></div>
        </div>

        <footer class="e3d__foot">
          <div class="e3d__choice">
            <p class="e3d__label">Color <strong data-e3d-name></strong></p>
            <div class="e3d__swatches" role="group" aria-label="Color del paletero" data-e3d-swatches></div>
            <p class="e3d__note" data-e3d-note hidden>Vista previa de colores. El color a comprar se elige en la ficha.</p>
          </div>
          <p class="e3d__hint">Arrastra para girarlo · pellizca o usa la rueda para acercar</p>
          <button type="button" class="button e3d__done" data-e3d-close>{{ block.settings.done_label | escape }}</button>
        </footer>
      </div>
    </dialog>
  </ehora-3d>
{%- elsif request.design_mode -%}
  <p class="e3d__editor-note">Ver en 3D: activa «Mostrar el botón» y pega la URL del modelo (.glb) en este bloque.</p>
{%- endif -%}

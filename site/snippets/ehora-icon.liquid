{%- comment -%} Iconos de línea EHORA. Accepts: name {%- endcomment -%}
<svg class="ehora-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'display' -%}
      <circle cx="16" cy="16" r="12"/><path d="M10 14h3v5h-3zM15 14h2v5M19 14h3v5h-3z" stroke-linecap="square"/>
    {%- when 'touch' -%}
      <circle cx="9" cy="16" r="4"/><circle cx="23" cy="16" r="4"/><path d="M7.5 16h3M21.5 16h3M23 14.5v3"/>
    {%- when 'usb' -%}
      <rect x="9" y="12" width="14" height="8" rx="4"/><path d="M13 16h6"/>
    {%- when 'battery' -%}
      <rect x="6" y="11" width="18" height="10" rx="1.5"/><path d="M26 14v4M9 14v4M12 14v4M15 14v4"/>
    {%- when 'pressure' -%}
      <path d="M6 22a10 10 0 1 1 20 0"/><path d="M16 22l5-7"/><circle cx="16" cy="22" r="1"/>
    {%- when 'ball' -%}
      <circle cx="16" cy="16" r="10"/><path d="M8.5 9.5c4 3 4 10 0 13M23.5 9.5c-4 3-4 10 0 13"/>
    {%- when 'hand' -%}
      <path d="M11 16V9a2 2 0 0 1 4 0v6M15 14V7a2 2 0 0 1 4 0v8M19 14a2 2 0 0 1 4 0v4a8 8 0 0 1-8 8h-1a7 7 0 0 1-6-3.5L7 19a2 2 0 0 1 3.5-2L11 18"/>
    {%- else -%}
      <circle cx="16" cy="16" r="2"/>
  {%- endcase -%}
</svg>
